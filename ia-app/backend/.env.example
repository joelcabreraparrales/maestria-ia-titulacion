# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGINS="http://localhost:4200,http://localhost:3000"

# ── Base de datos principal (auth + chatbot metadata) ────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/chatbot_bi?schema=public"

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_secret_in_production"
JWT_EXPIRES_IN="8h"

# ── ERP — base de datos que el chatbot consulta ──────────────────────────────
ERP_DATABASE_URL="postgresql://postgres:Doctor789@localhost:5432/adventureworks"
ERP_TARGET_SCHEMAS="dbo,humanresources,person,production,public,purchasing,sales"
ERP_QUERY_TIMEOUT_MS=30000

# ── Caché de schema en memoria ───────────────────────────────────────────────
SCHEMA_CACHE_TTL_SECONDS=300

# ── HuggingFace — modelo LLM para generación de SQL y análisis ───────────────
HF_API_KEY=hf_your_api_key_here
HF_IA_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
