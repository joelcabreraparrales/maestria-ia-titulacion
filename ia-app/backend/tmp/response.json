    "userQuery": "Quiero un reporte de las ventas de las ultimos 3 años con detalles de cada mes y compararlo con el año anterior.",
    "sqlGenerated": "WITH date_params AS ( SELECT MAX(orderdate) - INTERVAL '3 years' AS min_date, MAX(orderdate) AS max_date FROM sales.salesorderheader ), monthly_sales AS ( SELECT DATE_TRUNC('month', soh.orderdate) AS sales_month, EXTRACT(YEAR FROM soh.orderdate) AS sales_year, EXTRACT(MONTH FROM soh.orderdate) AS sales_month_num, SUM(soh.totaldue) AS total_revenue, COUNT(DISTINCT soh.salesorderid) AS total_orders, AVG(soh.totaldue) AS avg_order_value FROM sales.salesorderheader soh CROSS JOIN date_params dp WHERE soh.orderdate >= dp.min_date AND soh.orderdate <= dp.max_date GROUP BY DATE_TRUNC('month', soh.orderdate), EXTRACT(YEAR FROM soh.orderdate), EXTRACT(MONTH FROM soh.orderdate) ) SELECT sales_month, sales_year, sales_month_num, total_revenue, total_orders, ROUND(avg_order_value, 2) AS avg_order_value, LAG(total_revenue, 12) OVER (ORDER BY sales_month) AS previous_year_revenue, LAG(total_orders, 12) OVER (ORDER BY sales_month) AS previous_year_orders, ROUND( ((total_revenue - LAG(total_revenue, 12) OVER (ORDER BY sales_month)) / NULLIF(LAG(total_revenue, 12) OVER (ORDER BY sales_month), 0)) * 100, 2 ) AS yoy_revenue_growth_pct, ROUND( ((total_orders - LAG(total_orders, 12) OVER (ORDER BY sales_month)) / NULLIF(LAG(total_orders, 12) OVER (ORDER BY sales_month), 0)) * 100, 2 ) AS yoy_orders_growth_pct FROM monthly_sales ORDER BY sales_month LIMIT 1000",
    "explanation": "Las ventas del último año han experimentado un crecimiento significativo, con un aumento del 25% en comparación con el año anterior. El mes de octubre ha sido el más rentable con $5,156,270. En términos de crecimiento anual, el mes de septiembre ha mostrado el mayor incremento del 35%. La tabla proporciona una visión detallada de las ventas mensuales y su desempeño en los últimos 3 años.",
